{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mvn: build",
      "type": "shell",
      "command": "mvn clean package -DskipTests",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$java",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "mvn: test",
      "type": "shell",
      "command": "mvn test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$java",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "mvn: verify (unit + integration)",
      "type": "shell",
      "command": "mvn verify -Pintegration-tests",
      "group": "test",
      "problemMatcher": "$java",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "mvn: fat-jar",
      "type": "shell",
      "command": "mvn clean package -DskipTests -Pshade",
      "group": "build",
      "problemMatcher": "$java",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "mvn: static-analysis",
      "type": "shell",
      "command": "mvn verify -Pstatic-analysis -DskipTests",
      "group": "build",
      "problemMatcher": "$java",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "mvn: dependency tree",
      "type": "shell",
      "command": "mvn dependency:tree -Dverbose",
      "group": "none",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "mvn: update dependencies",
      "type": "shell",
      "command": "mvn versions:display-dependency-updates versions:display-plugin-updates",
      "group": "none",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
