{
  // ────────────────────────────────────────────────────────────────────────────
  // Java Language Server (JDT.LS) – heap & GC
  // ZGC Generational keeps GC pauses < 1 ms at large heap sizes.
  // Tune -Xmx: 4g for workstations ≥ 16 GB RAM, 2g for laptops.
  // ────────────────────────────────────────────────────────────────────────────
  "java.jdt.ls.vmargs": "-noverify -Xms512m -Xmx4g -XX:+UseZGC -XX:+ZGenerational -XX:SoftRefLRUPolicyMSPerMB=50 -XX:+AlwaysPreTouch -XX:+UseStringDeduplication -XX:+OptimizeStringConcat -Djdk.attach.allowAttachSelf=true -Djava.awt.headless=true -Dfile.encoding=UTF-8",

  // ────────────────────────────────────────────────────────────────────────────
  // Java project configuration
  // ────────────────────────────────────────────────────────────────────────────
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.autobuild.enabled": true,
  "java.maxConcurrentBuilds": 2,
  "java.project.encoding": "UTF-8",
  "java.import.maven.enabled": true,
  "java.import.gradle.enabled": false,
  "java.compile.nullAnalysis.mode": "automatic",

  // ────────────────────────────────────────────────────────────────────────────
  // Completion & IntelliSense performance
  // ────────────────────────────────────────────────────────────────────────────
  "java.completion.enabled": true,
  "java.completion.matchCase": "auto",
  "java.completion.lazyResolveTextEdit.enabled": true,
  "java.completion.postfix.enabled": true,

  // IntelliSense: show only literals param names to stay snappy
  "java.inlayHints.parameterNames.enabled": "literals",

  // Disable heavy code-lens passes that trigger full type resolution
  "java.referencesCodeLens.enabled": false,
  "java.implementationsCodeLens.enabled": false,

  // ────────────────────────────────────────────────────────────────────────────
  // Debugger
  // ────────────────────────────────────────────────────────────────────────────
  "java.debug.settings.hotCodeReplace": "auto",
  "java.debug.settings.enableRunDebugCodeLens": true,
  "java.debug.settings.forceBuildBeforeDebug": true,

  // ────────────────────────────────────────────────────────────────────────────
  // Test runner
  // ────────────────────────────────────────────────────────────────────────────
  "java.test.defaultConfig": "junit5",

  // ────────────────────────────────────────────────────────────────────────────
  // Isolate heavy Java extensions into their own extension host process
  // so a JDT.LS GC pause does NOT freeze the whole editor.
  // ────────────────────────────────────────────────────────────────────────────
  "extensions.experimental.affinity": {
    "redhat.java": 1,
    "vscjava.vscode-java-debug": 1,
    "vscjava.vscode-java-test": 1,
    "vscjava.vscode-maven": 1
  },

  // ────────────────────────────────────────────────────────────────────────────
  // File watcher – exclude Maven build output & IDE metadata
  // Fewer watcher events → lower CPU & memory churn
  // ────────────────────────────────────────────────────────────────────────────
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/target/**": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings/**": true
  },
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "search.exclude": {
    "**/target": true,
    "**/*.class": true,
    "**/*.jar": true
  },

  // ────────────────────────────────────────────────────────────────────────────
  // Maven extension
  // ────────────────────────────────────────────────────────────────────────────
  "maven.executable.preferMavenWrapper": true,
  "maven.terminal.useJavaHome": true,

  // ────────────────────────────────────────────────────────────────────────────
  // Terminal environment – set MAVEN_OPTS for every integrated terminal.
  // ZGC keeps Maven daemon GC pauses imperceptible.
  // -Dmaven.artifact.threads=8 speeds up parallel dependency resolution.
  // ────────────────────────────────────────────────────────────────────────────
  "terminal.integrated.env.linux": {
    "MAVEN_OPTS": "-Xms256m -Xmx2g -XX:+UseZGC -XX:+ZGenerational -Dmaven.artifact.threads=8",
    "JAVA_TOOL_OPTIONS": "-Dfile.encoding=UTF-8"
  },
  "terminal.integrated.env.osx": {
    "MAVEN_OPTS": "-Xms256m -Xmx2g -XX:+UseZGC -XX:+ZGenerational -Dmaven.artifact.threads=8",
    "JAVA_TOOL_OPTIONS": "-Dfile.encoding=UTF-8"
  },
  "terminal.integrated.env.windows": {
    "MAVEN_OPTS": "-Xms256m -Xmx2g -XX:+UseZGC -XX:+ZGenerational -Dmaven.artifact.threads=8",
    "JAVA_TOOL_OPTIONS": "-Dfile.encoding=UTF-8"
  },

  // ────────────────────────────────────────────────────────────────────────────
  // Editor (reduce rerender load)
  // ────────────────────────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "editor.quickSuggestionsDelay": 150,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.semanticHighlighting.enabled": true,

  // Java-specific editor overrides
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true
  },

  // ────────────────────────────────────────────────────────────────────────────
  // Organise imports thresholds
  // ────────────────────────────────────────────────────────────────────────────
  "java.sources.organizeImports.staticStarThreshold": 3,
  "java.sources.organizeImports.starThreshold": 5
}
