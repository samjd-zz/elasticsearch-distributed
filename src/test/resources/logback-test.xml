<?xml version="1.0" encoding="UTF-8"?>
<!-- Lightweight logback config for unit/integration tests – console only, no file I/O -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.elasticsearch.distributed" level="DEBUG" />
  <logger name="co.elastic.clients"             level="WARN" />
  <logger name="org.testcontainers"             level="INFO" />

  <root level="WARN">
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>
